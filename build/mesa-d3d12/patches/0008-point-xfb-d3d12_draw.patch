+static bool
+madeira_prepare_point_xfb(struct d3d12_context *ctx,
+                          const pipe_draw_info *info,
+                          const pipe_draw_indirect_info *indirect,
+                          const pipe_draw_start_count_bias *draw)
+{
+   ctx->madeira_point_xfb = false;
+   if (!debug_get_option_madeira_point_xfb() ||
+       !ctx->gfx_pipeline_state.num_so_targets ||
+       !ctx->gfx_pipeline_state.rast->base.rasterizer_discard)
+      return true;
+   auto vs = ctx->gfx_stages[PIPE_SHADER_VERTEX];
+   bool supported = vs && vs->so_info.num_outputs && !indirect &&
+      info->mode == MESA_PRIM_POINTS && !info->index_size &&
+      info->instance_count == 1 && !ctx->current_predication &&
+      !ctx->gfx_stages[PIPE_SHADER_TESS_CTRL] &&
+      !ctx->gfx_stages[PIPE_SHADER_TESS_EVAL] &&
+      (!ctx->gfx_stages[PIPE_SHADER_GEOMETRY] || ctx->gfx_stages[PIPE_SHADER_GEOMETRY]->is_variant) &&
+      vs->initial->info.num_ssbos + PIPE_MAX_SO_BUFFERS <= PIPE_MAX_SHADER_BUFFERS;
+   if (supported) {
+      for (unsigned i = 0; i < vs->so_info.num_outputs; ++i) {
+         const pipe_stream_output &out = vs->so_info.output[i];
+         bool found = false;
+         nir_foreach_variable_with_modes(var, vs->initial, nir_var_shader_out) {
+            if (var->data.location == out.register_index &&
+                (glsl_type_is_vector(var->type) || glsl_type_is_scalar(var->type)) &&
+                glsl_get_bit_size(var->type) == 32 && !out.stream &&
+                out.start_component >= var->data.location_frac &&
+                out.start_component + out.num_components <=
+                   var->data.location_frac + glsl_get_vector_elements(var->type))
+               found = true;
+         }
+         supported &= found;
+      }
+   }
+   if (!supported) {
+      static bool warned;
+      if (!warned) {
+         _debug_printf("[madeira-mesa] unsupported transform feedback shape; point UAV fallback not used\n");
+         warned = true;
+      }
+      return false;
+   }
+   ctx->madeira_xfb_limit = draw->count;
+   for (unsigned i = 0; i < PIPE_MAX_SO_BUFFERS; ++i) {
+      unsigned stride = vs->so_info.stride[i] * 4;
+      if (!stride) continue;
+      auto target = (d3d12_stream_output_target *)ctx->so_targets[i];
+      unsigned remaining = target && target->madeira_filled_size <= target->base.buffer_size ?
+         target->base.buffer_size - target->madeira_filled_size : 0;
+      ctx->madeira_xfb_limit = MIN2(ctx->madeira_xfb_limit, remaining / stride);
+   }
+   ctx->madeira_point_xfb = true;
+   ctx->shader_dirty[PIPE_SHADER_VERTEX] |= D3D12_SHADER_DIRTY_SSBO;
+   static bool announced;
+   if (!announced) {
+      _debug_printf("[madeira-mesa] point transform feedback uses ordered vertex UAV writes\n");
+      announced = true;
+   }
+   return true;
+}
