Keep Mesa's shared submission fence where supported, with a private timeline
fallback for backends that explicitly reject shared fences. Retain Mesa's
existing source notices and license.

--- a/src/gallium/drivers/d3d12/d3d12_screen.cpp
+++ b/src/gallium/drivers/d3d12/d3d12_screen.cpp
@@ -1473,6 +1473,28 @@
 }
 #endif
 
+/* iDeck: a private queue timeline does not require cross-process sharing.
+ * Keep real shared fences where supported. Only an unsupported operation may
+ * fall back; allocation/device failures must retain their original failure. */
+static bool
+madeira_create_submission_fence(struct d3d12_screen *screen)
+{
+   HRESULT hr = screen->dev->CreateFence(0, D3D12_FENCE_FLAG_SHARED,
+                                        IID_PPV_ARGS(&screen->fence));
+   if (SUCCEEDED(hr))
+      return true;
+   if (hr != E_NOTIMPL && hr != DXGI_ERROR_UNSUPPORTED) {
+      fprintf(stderr, "[opengl-d3d12] shared submission fence failed: 0x%08lx\n", (unsigned long)hr);
+      return false;
+   }
+   fprintf(stderr, "[opengl-d3d12] shared submission fence unsupported (0x%08lx); trying a private fence\n", (unsigned long)hr);
+   hr = screen->dev->CreateFence(0, D3D12_FENCE_FLAG_NONE,
+                                 IID_PPV_ARGS(&screen->fence));
+   if (FAILED(hr))
+      fprintf(stderr, "[opengl-d3d12] private submission fence failed: 0x%08lx\n", (unsigned long)hr);
+   return SUCCEEDED(hr);
+}
