SPDX-License-Identifier: MIT
Expose context initialization progress through Mesa's debugger log sink
so GUI applications without a console still report initialization errors.
Retain Mesa's existing source notices and license.

--- a/src/gallium/frontends/wgl/stw_context.c
+++ b/src/gallium/frontends/wgl/stw_context.c
@@ -245,10 +245,15 @@
 
    attribs.options = stw_dev->st_options;
 
+   _debug_printf("[opengl-d3d12] creating WGL context: version=%d.%d profile=0x%x format=%d\n",
+                 majorVersion, minorVersion, profileMask, pfi ? pfi->iPixelFormat : 0);
    ctx->st = st_api_create_context(
          fscreen, &attribs, &ctx_err, shareCtx ? shareCtx->st : NULL);
-   if (ctx->st == NULL)
+   if (ctx->st == NULL) {
+      _debug_printf("[opengl-d3d12] WGL context creation failed: error=%u\n", (unsigned)ctx_err);
       goto no_st_ctx;
+   }
+   _debug_printf("[opengl-d3d12] WGL context created\n");
 
    ctx->st->frontend_context = (void *) ctx;
 
